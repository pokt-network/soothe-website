{
  "name": "@soothe/api",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "run-p start:watch build:watch",
    "build": "node esbuild.js",
    "build:watch": "yarn build --watch",
    "build:prod": "yarn build --minify",
    "start": "node -r dotenv/config ./dist/index.js dotenv_config_path=../../../.env",
    "start:watch": "nodemon --exec \"node -r esbuild-register -r dotenv/config ./dist/index.js dotenv_config_path=../../../.env dotenv_config_debug=true\" -e .ts -w ../../../.env",
    "start:docker": "node ./dist/index.js",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf dist && rm -f tsconfig.tsbuildinfo && rm -f *.pid",
    "typecheck": "tsc src/index.ts --noEmit"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "4.18.2"
  },
  "devDependencies": {
    "typescript": "4.8.2",
    "@types/express": "4.17.17",
    "@soothe/tsconfig": "0.0.1",
    "@soothe/scripts": "0.0.1"
  }
}
